// Dungeon Keeper II lighting model (lighting_design.md §9), reproduced
// exactly, including its out-of-range behaviour (design decision D7).
//
// F(n) = 0.25 + 16/n     for n in 0..255   (F(0) = +infinity)
// F(n) = n - 256         for n >= 256       (the original runs off the end
//                                            of its table into a
//                                            neighbouring one -- kept on
//                                            purpose, not a bug fix target)
float dkFalloff(float n) {
    if (n < 0.5) {
        // n == 0: the table is +infinity here. Any sufficiently large value
        // works, since the caller immediately clamps the contribution to
        // the light colour (design's "(k > 1) ? C : C*k" saturation).
        return 1e6;
    }
    if (n < 256.0) {
        return 0.25 + 16.0 / n;
    }
    return n - 256.0;
}

// One point light's additive per-vertex contribution (design §9's
// per-vertex/Gouraud evaluation mode). `lightColor` is already 0..1 and
// `intensity` is the source's effective (flicker-scaled) intensity --
// note the design deliberately dots the surface normal against the
// UN-normalized light vector `d` (not its normalized direction): this is
// how the original's falloff and "1 tile from a torch is full colour"
// behaviour actually combine, not a mistake to "fix" into a normalized
// Lambert term.
vec3 dkPointLightContribution(vec3 worldPos, vec3 worldNormal, vec3 lightPos,
        float radius, vec3 lightColor, float intensity) {
    vec3 d = lightPos - worldPos;
    float d2 = dot(d, d);
    float r2 = radius * radius;
    if (r2 <= 0.0 || d2 >= r2) {
        return vec3(0.0);
    }

    float lam = dot(worldNormal, d) * intensity;
    if (lam <= 0.0) {
        return vec3(0.0);
    }

    float n = floor(16.0 * d2);
    float k = (r2 - d2) * dkFalloff(n) * (1.0 / r2) * lam;
    return lightColor * min(k, 1.0);
}

// Soft-knee compression of the FINAL summed colour (ambient + every
// light's contribution), applied once per channel right before the
// diffuse multiply -- NOT per-light. Each light's own saturation
// ("(k > 1) ? C : C*k") is left exactly as design §9 specifies; this only
// stops several already-saturated overlapping lights (e.g. a
// torch-lined corridor) from stacking straight to flat white. Below
// DK_SOFTCLAMP_KNEE the value passes through unchanged; above it, the
// excess is compressed so the total asymptotically approaches
// DK_SOFTCLAMP_CEILING instead of hitting the hardware's hard [0,1] clip.
#define DK_SOFTCLAMP_KNEE 0.85
#define DK_SOFTCLAMP_CEILING 1.0

float dkSoftClampChannel(float x) {
    if (x <= DK_SOFTCLAMP_KNEE) {
        return x;
    }
    float span = DK_SOFTCLAMP_CEILING - DK_SOFTCLAMP_KNEE;
    float excess = x - DK_SOFTCLAMP_KNEE;
    return DK_SOFTCLAMP_CEILING - (span * span) / (excess + span);
}

vec3 dkSoftClamp(vec3 sum) {
    return vec3(dkSoftClampChannel(sum.r), dkSoftClampChannel(sum.g), dkSoftClampChannel(sum.b));
}
