MaterialDef DK Terrain Lighting {

    MaterialParameters {
        Texture2D DiffuseMap

        // KmfModelLoader.setMaterialFlags sets this on every material it
        // creates (terrain included, e.g. RANDOM_TEXTURE/alpha pieces) --
        // must be declared here or that call throws.
        Float AlphaDiscardThreshold

        // Vertex ambient (design §8.1): a per-terrain-type constant, 0..1,
        // already converted from the file's 0..511 channel + over-bright
        // bits by the Java side. Defaulted to black -- an unset Color
        // MaterialParameter is an uninitialized GPU uniform, not zero.
        Color Ambient : 0.0 0.0 0.0 0.0

        // Global ambient (design §8.2): the video "ambient light" setting,
        // 0..0.5, added to every lit mesh's base colour. Defaulted to
        // black for the same reason as Ambient above -- SceneLights only
        // starts pushing a live value once this material is registered
        // and the first per-frame update has run.
        Color GlobalAmbient : 0.0 0.0 0.0 0.0

        // Up to MAX_LIGHTS point lights affecting this geometry, packed by
        // SceneLights (design §4/§11) -- xyz = world position (tile
        // units), w = radius (tiles).
        Vector4Array LightPosRadius

        // rgb = colour (0..1, already flicker/pulse/fade-modulated), w =
        // effective intensity (design §7.2's flicker included).
        Vector4Array LightColorIntensity

        // How many of the two arrays above are actually populated this
        // upload (unused slots are not evaluated, not just zeroed).
        // Defaulted to 0 so a material never read by SceneLights (yet)
        // doesn't evaluate an uninitialized light array.
        Int NumLights : 0
    }

    Technique {
        VertexShader GLSL150: Shaders/DkLighting/DkTerrain.vert
        FragmentShader GLSL150: Shaders/DkLighting/DkTerrain.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            WorldNormalMatrix
        }

        Defines {
            DISCARD_ALPHA : AlphaDiscardThreshold
        }
    }
}
