MaterialDef ProgressIndicator {

    MaterialParameters {
        Texture2D Texture
        Color Color (Color)
        Boolean VertexColor (UseVertexColor)
        Float Progress
    }

    Technique {
        VertexShader   GLSL330 GLSL300: Shaders/Gui/ProgressIndicator.vert
        FragmentShader GLSL330 GLSL300: Shaders/Gui/ProgressIndicator.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }

        Defines {
            TEXTURE : Texture
            VERTEX_COLOR : VertexColor
        }
    }

}