                    <control name="property" label="Recommended Size" value="$size"/>
                    <control name="property" label="Research Time" value="$researchTime"/>
                    <control name="property" label="Return Percentage" value="$returnPercentage"/>

                </panel>
            </control>
        </panel>
    </controlDefinition>

