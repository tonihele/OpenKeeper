                    <text style="text" text="Name" align="center" />
                    <text style="text" text="$namestring" textHAlign="left" wrap="true" />

                    <text style="text" text="General Description" align="center" />
                    <text style="text" text="$genDesc" textHAlign="left" wrap="true" />

                    <text style="text" text="Strength" align="center" />
