<?xml version="1.0" encoding="UTF-8"?>
<nifty-styles xmlns="http://nifty-gui.lessvoid.com/nifty-gui">
    <style id="nifty-scrollpanel#scrollpanel">
        <attributes backgroundColor="#000e" />
    </style>
    <style id="viewer-option-style#panel">
        <effect>
            <onFocus name="border" color="#888f" post="true" inset="1px"/>
            <onHover name="border" color="#666f" post="true" inset="1px"/>
        </effect>
    </style>
    <style id="viewer-option-style#box">
        <attributes width="18px" height="18px" childLayout="center" backgroundColor="#444f"/>
        <effect>
            <onActive name="border" color="#888f" post="true" inset="1px"/>
        </effect>
    </style>
    <style id="viewer-option-style#select">
        <attributes align="center" valign="center" width="18px" height="18px"
                    backgroundImage="checkbox/checkbox.png"/>
    </style>
</nifty-styles>
