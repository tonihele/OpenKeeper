<?xml version="1.0" encoding="UTF-8"?>
<nifty xmlns="http://nifty-gui.lessvoid.com/nifty-gui" xmlns:xsi="http://www.w3.org/2001/XMLSchema">
    <useStyles filename="nifty-default-styles.xml" />
    <useStyles filename="Interface/ModelViewer/MyStyle.xml" />
    <useControls filename="nifty-default-controls.xml" />
    <useControls filename="Interface/ModelViewer/MyControls.xml" />

    <!-- +++++++++++++++++++++++++++++++++++++++ -->
    <!-- Main Screen for model loader -->
    <!-- +++++++++++++++++++++++++++++++++++++++ -->
    <screen id="start" controller="toniarts.openkeeper.tools.modelviewer.ModelViewerScreenController">
        <layer childLayout="horizontal">
            <panel childLayout="vertical" width="18%" valign="top" align="left" height="100%">
                <panel childLayout="center" width="100%" height="28px" backgroundColor="#111f">
                    <control name="dropDown" id="types" displayItems="10" width="100%"/>
                </panel>
                <panel childLayout="horizontal" width="100%" height="24px" backgroundColor="#111f">
                    <text style="text" text="Filter" width="50px" valign="center"/>
                    <control name="textfield" id="filter" text="" maxLength="64" width="*"/>
                </panel>
                <panel id="selectionOptions" childLayout="vertical" width="100%" height="148px"
                       padding="8px" backgroundColor="#000f">
                    <text style="text" text="Options" width="100%" height="20px" textHAlign="left"/>
                    <panel childLayout="horizontal" width="100%" height="28px" valign="center">
                        <control name="checkbox" id="autoRotate" style="viewer-checkbox-style" valign="center"/>
                        <panel width="8px"/>
                        <text style="text" text="Auto-rotate" width="*" valign="center"/>
                        <text style="text" text="Alt+R" width="48px" valign="center" textHAlign="right"/>
                    </panel>
                    <panel childLayout="horizontal" width="100%" height="28px" valign="center">
                        <control name="checkbox" id="showNormals" style="viewer-checkbox-style" valign="center"/>
                        <panel width="8px"/>
                        <text style="text" text="Show normals" width="*" valign="center"/>
                        <text style="text" text="Alt+N" width="48px" valign="center" textHAlign="right"/>
                    </panel>
                    <panel childLayout="horizontal" width="100%" height="28px" valign="center">
                        <control name="checkbox" id="wireframe" style="viewer-checkbox-style" valign="center"/>
                        <panel width="8px"/>
                        <text style="text" text="Wireframe" width="*" valign="center"/>
                        <text style="text" text="Alt+T" width="48px" valign="center" textHAlign="right"/>
                    </panel>
                    <panel childLayout="horizontal" width="100%" height="28px" valign="center">
                        <control name="checkbox" id="showCeiling" style="viewer-checkbox-style" valign="center"/>
                        <panel width="8px"/>
                        <text style="text" text="Map ceiling" width="*" valign="center"/>
                        <text style="text" text="Alt+C" width="48px" valign="center" textHAlign="right"/>
                    </panel>
                </panel>
                <control name="listBox" id="items" horizontal="optional" selection="Single"
                         vertical="on" forceSelection="true" displayItems="20"/>
            </panel>
            <panel width="*" height="100%"/>
            <panel id="item" childLayout="vertical" width="24%" valign="top" height="100%"/>
        </layer>
    </screen>
</nifty>
